# Copia a .env (o exporta las variables) para ajustar el tablero.
HOST=0.0.0.0
PORT=1000
# URL de la API que usan boardctl, los workers y el MCP
BOARD_API=http://localhost:1000/api
# Carpeta de datos (SQLite, logs, PIDs). Por defecto ./data
# BOARD_DATA_DIR=/ruta/a/data
# Carpeta de trabajo por defecto de los workers agy
# BOARD_WORKDIR=/ruta/a/mi-proyecto
AUTO_AUDIT=1
